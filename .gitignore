# Local game data working copy (never commit — large, user-owned)
/work/

# Vendored upstream working tree — reconstructed by scripts/bootstrap.sh (pinned
# clone with its own .git). NOT committed: the pin lives in bootstrap.sh; local
# changes live in overlay/patches/.
/vendor/2ship2harkinian/

# Build outputs
/oracle/build-*/
/oracle/shiphome/
/app/build-*/
/build-*/
/build/
DerivedData/
*.xcodeproj/
*.o
*.a
*.dylib

# Captured artifacts — keep the dir, ignore heavy contents
/artifacts/*.mov
/artifacts/*.mp4
/artifacts/*.trace
/artifacts/*.png
/artifacts/*.log
/artifacts/*.otr
/artifacts/*.o2r
# Unstripped binaries kept for symbolicating crash.txt (~52 MB each, one per
# publish, regenerated by publish-ota.sh) — local debugging asset, not history.
/artifacts/symbols/
# Captured logs living in per-investigation subdirs (the *.log rule above only
# matches the top level).
/artifacts/**/*.log

# Public release IPAs — rebuildable by publish-tools/build-release-ipas.sh and
# ~20 MB each; the GitHub Release is where they live permanently.
/release/

# macOS
.DS_Store
xcuserdata/
*.xcuserstate

# Spike build trees (rebuildable; huge FetchContent checkouts)
/spikes/*-build/
/spikes/*.log

# 2026-10-09 device crash pull: keep only the 2ship .ips + config; the full
# device diagnostics dump (~440 MB) and the downloaded IPAs stay local.
/artifacts/device-crash-2026-10-09/ips/*
!/artifacts/device-crash-2026-10-09/ips/2ship-*.ips
/artifacts/device-crash-2026-10-09/ipa/
/artifacts/device-crash-2026-10-09/*.ipa
