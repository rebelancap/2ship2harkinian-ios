carries 0050 the generator diffs against a reversed temp copy).


--- a/libultraship/src/fast/Fast3dWindow.cpp
+++ b/libultraship/src/fast/Fast3dWindow.cpp
@@ -36,7 +36,12 @@
         AddAvailableWindowBackend(WindowBackend::FAST3D_SDL_METAL);
     }
 #endif
+    // SOH_IOS (overlay 0050, D-062): only offer OpenGL when it is compiled in. The iOS
+    // build has no ENABLE_OPENGL; offering it let a saved id 2 reach InitWindowManager's
+    // default: case and crash at launch (OTA 1.1.1.1). Newer LUS gates it the same way.
+#ifdef ENABLE_OPENGL
     AddAvailableWindowBackend(WindowBackend::FAST3D_SDL_OPENGL);
+#endif
 }
 
 Fast3dWindow::Fast3dWindow(std::shared_ptr<Ship::Gui> gui)
@@ -163,6 +168,17 @@
 #endif
         default:
             SPDLOG_ERROR("Could not load the correct rendering backend");
+#ifdef __APPLE__
+            // SOH_IOS (overlay 0050, D-062): never leave the APIs null (Interpreter::Init
+            // dereferences them). Fall back to Metal and record it in the config.
+            SPDLOG_ERROR("Window backend {} not built in; falling back to Metal", GetWindowBackend());
+            Ship::Context::GetRawInstance()->GetConfig()->SetString(
+                "Window.Backend.LastRejected", "InitWindowManager default: backend " +
+                                                   std::to_string(GetWindowBackend()) + " not built in; using Metal");
+            SetWindowBackend(WindowBackend::FAST3D_SDL_METAL);
+            mRenderingApi = new GfxRenderingAPIMetal();
+            mWindowManagerApi = new GfxWindowBackendSDL2();
+#endif
             break;
     }
 }
