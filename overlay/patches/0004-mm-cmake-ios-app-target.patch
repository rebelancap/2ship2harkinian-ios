     )
     target_include_directories(${PROJECT_NAME} PRIVATE
         ${DEVKITPRO}/portlibs/wiiu/include/
+    )
+elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # SDL2 comes statically from libultraship's FetchContent (OVERRIDE_FIND_PACKAGE).
+    find_package(SDL2 REQUIRED)
+    set(THREADS_PREFER_PTHREAD_FLAG ON)
+    find_package(Threads REQUIRED)
+    # SDL2_net is NOT needed: BUILD_CROWD_CONTROL is off and its link entry is
+    # commented upstream. Static audio codec libs are prebuilt for iOS and
+    # injected by prefix (scripts/build-audio-deps-ios.sh).
+    set(SOH_IOS_DEPS_PREFIX "" CACHE PATH "Prefix containing static ogg/vorbis/opus/opusfile for iOS")
+    foreach(_l ogg vorbis vorbisenc vorbisfile opus opusfile)
+        if(NOT EXISTS "${SOH_IOS_DEPS_PREFIX}/lib/lib${_l}.a")
+            message(FATAL_ERROR "iOS build requires -DSOH_IOS_DEPS_PREFIX with lib/lib${_l}.a (got '${SOH_IOS_DEPS_PREFIX}')")
+        endif()
+    endforeach()
+    add_library(Ogg::ogg STATIC IMPORTED)
+    set_target_properties(Ogg::ogg PROPERTIES IMPORTED_LOCATION "${SOH_IOS_DEPS_PREFIX}/lib/libogg.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${SOH_IOS_DEPS_PREFIX}/include")
+    add_library(Vorbis::vorbis STATIC IMPORTED)
+    set_target_properties(Vorbis::vorbis PROPERTIES IMPORTED_LOCATION "${SOH_IOS_DEPS_PREFIX}/lib/libvorbis.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${SOH_IOS_DEPS_PREFIX}/include")
+    add_library(Vorbis::vorbisenc STATIC IMPORTED)
+    set_target_properties(Vorbis::vorbisenc PROPERTIES IMPORTED_LOCATION "${SOH_IOS_DEPS_PREFIX}/lib/libvorbisenc.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${SOH_IOS_DEPS_PREFIX}/include")
+    add_library(Vorbis::vorbisfile STATIC IMPORTED)
+    set_target_properties(Vorbis::vorbisfile PROPERTIES IMPORTED_LOCATION "${SOH_IOS_DEPS_PREFIX}/lib/libvorbisfile.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${SOH_IOS_DEPS_PREFIX}/include")
+    add_library(Opus::opus STATIC IMPORTED)
+    set_target_properties(Opus::opus PROPERTIES IMPORTED_LOCATION "${SOH_IOS_DEPS_PREFIX}/lib/libopus.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${SOH_IOS_DEPS_PREFIX}/include;${SOH_IOS_DEPS_PREFIX}/include/opus")
+    add_library(Opusfile::Opusfile STATIC IMPORTED)
+    set_target_properties(Opusfile::Opusfile PROPERTIES IMPORTED_LOCATION "${SOH_IOS_DEPS_PREFIX}/lib/libopusfile.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${SOH_IOS_DEPS_PREFIX}/include;${SOH_IOS_DEPS_PREFIX}/include/opus")
+    set(ADDITIONAL_LIBRARY_DEPENDENCIES
+        "libultraship;"
+        "ZAPDLib;"
+        SDL2::SDL2-static
+        "$<$<NOT:$<BOOL:${SOH_VISIONOS}>>:SDL2main>"
+        "Ogg::ogg"
+        "Vorbis::vorbis"
+        "Vorbis::vorbisenc"
+        "Vorbis::vorbisfile"
+        "Opus::opus"
+        "Opusfile::Opusfile"
+        ${CMAKE_DL_LIBS}
+        Threads::Threads
     )
 else()
