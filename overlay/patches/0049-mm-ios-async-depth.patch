+// Phase control for the game (mm z_kankyo.c). harvest=0: the callback's submit pass;
+// harvest=1: the next tick's re-run. Returns 0 when async is off (or, for a
+// harvest, when nothing was ever submitted) -- the caller then skips the pass.
+extern "C" int SohIos_DepthAsyncBegin(int harvest) {
+    sSohZPhase = 0;
+    if (Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gSohIos.AsyncDepth", 1) == 0) {
+        return 0;
+    }
+    if (harvest && sSohZSeq == 0) {
+        return 0;
+    }
+    sSohZPhase = harvest ? 2 : 1;
+    sSohZGen++;
+    sSohZCheckOn =
+        Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gSohIos.AsyncDepthCheck", 0) != 0;
+    return 1;
+}
+extern "C" void SohIos_DepthAsyncEnd(void) {
+    sSohZPhase = 0;
+}
+extern "C" int SohIos_DepthAsyncPhase(void) {
+    return sSohZPhase;
+}
+extern "C" unsigned SohIos_DepthAsyncGen(void) {
+    return sSohZGen;
 }
+namespace {
+// Check mode: should the submit pass ALSO run the synchronous path, and keep
+// its answer for the harvest to compare against?
+bool SohZCheckWanted() {
+    return sSohZCheckOn && sSohZPhase == 1;
+}
+void SohZCheckRecord(const std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>& res) {
+    sSohZCheck.assign(res.begin(), res.end());
+    sSohZCheckSeq = sSohZSeq;
+}
+} // namespace
