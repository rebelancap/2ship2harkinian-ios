+extern "C" int SohIos_CamYawPitch(int* yaw, int* pitch) {
+    if (gPlayState == nullptr) {
+        return 0;
+    }
+    Camera* cam = gPlayState->cameraPtrs[gPlayState->activeCamId];
+    if (cam == nullptr) {
+        return 0;
+    }
+    VecGeo g = OLib_Vec3fDiffToVecGeo(&cam->at, &cam->eye);
+    *yaw = g.yaw;
+    *pitch = g.pitch;
+    return 1;
+}
